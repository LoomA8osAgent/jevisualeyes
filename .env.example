# jevisualeyes — offline author-time composer. Every key below is optional; the
# defaults are the loopback reference runtime and no network beyond it.

# Which provider answers. `local` (default) | `jev` | `fixture`.
# There is NO silent fallback between them (docs/COMPOSER.md §3.2): a failing `local`
# does not become `fixture`, and choosing `fixture` is explicit configuration.
JEV_PROVIDER=local

# `local` — an open-weight decision model on this machine (docs/COMPOSER.md §3).
# Launch it as:  von serve --host 127.0.0.1 --port 8493
# The host flag is NOT optional: `von serve` defaults to 0.0.0.0, which is a
# LAN-exposed decision server with no auth (docs/COMPOSER.md §3). This tool is
# loopback-only.
JEV_LOCAL_URL=http://127.0.0.1:8493
JEV_LOCAL_MODEL=von-latest
# docs/COMPOSER.md §3.1 — what the provider's NUMBER means. TRAINED | DECODE | DIFFUSION.
# Only a TRAINED provider may arm a confidence band; a DECODE server put behind
# JEV_LOCAL_URL must say so here, because the receipt records the class.
JEV_LOCAL_CLASS=TRAINED

# `jev` — the remote endpoint, Jev by TypeSafe AI (docs/COMPOSER.md §3). Opt-in. The key comes from the
# environment or the 0600 settings file, never from a repo file.
JEV_API_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
TYPESAFE_API_KEY=

# `fixture` — the planted answer map (docs/COMPOSER.md §3.2). A missing map is an ERROR, never
# an empty map: { "default": 0.9, "answers": { "<question id>": <answer> } }
JEV_FIXTURE=

# The job journal (a resumable bake's pending payloads, attempts, receipts, events).
DATA_DIR=./data

# Ceilings. The request ceiling PAUSES a run rather than failing it.
MAX_JOB_ATTEMPTS=12000
MAX_PROVIDER_BODY_BYTES=2097152
PROVIDER_ATTEMPT_TIMEOUT_MS=45000
PROVIDER_MAX_ATTEMPTS_PER_DECISION=4

# One explicitly authorized live call (scripts/live-smoke.mjs). Never set during a
# test, a gate or an install.
LIVE_JEV=0
