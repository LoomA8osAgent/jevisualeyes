{
  "name": "jevisualeyes",
  "version": "0.1.0",
  "private": true,
  "description": "jevisualeyes — an offline, author-time preset composer for A8os fragment-shader records: a decision model picks from menus that code enumerates, and code renders the result",
  "keywords": [
    "jevisualeyes",
    "a8os",
    "fragment-shader",
    "isf2",
    "presets",
    "decision-model",
    "composer",
    "offline"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:fixture": "tsx scripts/smoke-fixture.mjs",
    "compose:fixture": "tsx scripts/compose-fixture.mjs",
    "test:live": "tsx scripts/live-smoke.mjs",
    "deliver:fixture": "tsx scripts/deliver-fixture.mjs",
    "compose:shading": "tsx scripts/compose-shading.mjs",
    "deliver:shading": "tsx scripts/deliver-shading.mjs",
    "relabel:shading": "tsx scripts/relabel-shading.mjs"
  },
  "dependencies": {
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
