    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-smoke.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.1.22",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
