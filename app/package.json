{
  "name": "jevthoven",
  "version": "0.1.0",
  "private": true,
  "description": "Jevthoven — prompt-first live Jev symbolic-music web studio",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "tsx server/index.ts",
