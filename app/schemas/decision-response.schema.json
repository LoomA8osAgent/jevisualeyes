{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a8os.jev.decision-response.v1",
  "title": "Decision response — specs/ai/jev.md §1.2 + §10.1",
  "description": "SHAPE only. The binding checks in §10.1 are RELATIONAL — probability keys equal the submitted candidate keys, the sum is 1 ± 1e-3, and the reported choice is a maximum-probability candidate — and no schema can express them against the request. core/validate.ts is the enforcing implementation; this file never stands in for it.",
  "type": "object",
  "required": ["model", "answers", "usage"],
  "additionalProperties": true,
  "properties": {
    "model": {"type": "string", "minLength": 1, "maxLength": 200},
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "noul"],
            "properties": {
              "type": {"const": "noul"},
              "noul": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          {
            "type": "object",
            "required": ["type", "choice", "probabilities", "confidence"],
            "properties": {
              "type": {"const": "choice"},
              "choice": {"type": "string", "minLength": 1},
              "probabilities": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "number", "minimum": 0}},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          {
            "type": "object",
            "required": ["type", "score", "probabilities", "legend", "confidence"],
            "properties": {
              "type": {"const": "score"},
              "score": {"type": "number", "minimum": 0},
              "probabilities": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "number", "minimum": 0}},
              "legend": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string"}},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        ]
      }
    }
  }
}
