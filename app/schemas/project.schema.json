{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "jev-music.project.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "ppq": {
      "const": 480
    },
    "tempoBpm": {
      "type": "integer",
      "minimum": 40,
      "maximum": 220
    },
    "meter": {
      "type": "object",
      "properties": {
        "numerator": {
          "enum": [
            3,
            4,
            6
          ]
        },
        "denominator": {
          "enum": [
            4,
            8
          ]
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "swing": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "straight",
            "light",
            "shuffle",
            "custom"
          ]
        },
        "ratio": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.75
        }
      },
      "required": [
        "mode",
        "ratio"
      ],
      "additionalProperties": false
    },
    "lengthBars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "role": {
            "enum": [
              "intro",
              "theme",
              "variation",
              "contrast",
              "build",
              "drop",
              "return",
              "ending"
            ]
          },
          "startTick": {
            "type": "integer",
            "minimum": 0
          },
          "endTick": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "startTick",
          "endTick"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "harmonicPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startTick": {
            "type": "integer",
            "minimum": 0
          },
          "endTick": {
            "type": "integer",
            "minimum": 1
          },
          "rootPitchClass": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 11
          },
          "quality": {
            "enum": [
              "major",
              "minor",
              "dominant7",
              "major7",
              "minor7",
              "diminished",
              "sus2",
              "sus4",
              "no_chord"
            ]
          }
        },
        "required": [
          "startTick",
          "endTick",
          "rootPitchClass",
          "quality"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "role": {
            "enum": [
              "lead",
              "bass",
              "harmony",
              "drums"
            ]
          },
          "instrumentId": {
            "enum": [
              "electric_keys",
              "soft_keys",
              "organ",
              "pluck",
              "round_bass",
              "synth_bass",
              "soft_lead",
              "bright_lead",
              "drum_kit"
            ]
          },
          "program": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "channel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "volumeDb": {
            "type": "number",
            "minimum": -60,
            "maximum": 6
          },
          "pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "muted": {
            "type": "boolean"
          },
          "solo": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "startTick": {
                  "type": "integer",
                  "minimum": 0
                },
                "durationTicks": {
                  "type": "integer",
                  "minimum": 1
                },
                "midi": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "velocity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 127
                },
                "locked": {
                  "type": "boolean"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "jev",
                        "manual",
                        "derived",
                        "fixture"
                      ]
                    },
                    "decisionIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "uniqueItems": true,
                      "maxItems": 1000
                    },
                    "parentNoteIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "uniqueItems": true,
                      "maxItems": 1000
                    }
                  },
                  "required": [
                    "kind",
                    "decisionIds",
                    "parentNoteIds"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "startTick",
                "durationTicks",
                "midi",
                "velocity",
                "locked",
                "source"
              ],
              "additionalProperties": false
            },
            "maxItems": 50000
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "instrumentId",
          "program",
          "channel",
          "volumeDb",
          "pan",
          "muted",
          "solo",
          "locked",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4
    },
    "generation": {
      "type": "object",
      "properties": {
        "provenance": {
          "enum": [
            "live",
            "fixture",
            "mixed",
            "manual"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "candidateVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contextMode": {
          "enum": [
            "full",
            "explicit_rolling"
          ]
        },
        "selection": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "model",
                "sample"
              ]
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "mode",
            "temperature",
            "seed"
          ],
          "additionalProperties": false
        },
        "partial": {
          "type": "boolean"
        },
        "requestedLengthBars": {
          "type": "integer",
          "minimum": 4,
          "maximum": 64
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instruction": {
                "type": "string",
                "maxLength": 4000
              },
              "baseRevisionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": [
              "instruction",
              "baseRevisionId"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        }
      },
      "required": [
        "provenance",
        "model",
        "candidateVersion",
        "contextMode",
        "selection",
        "partial",
        "requestedLengthBars",
        "history"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revisionId",
    "title",
    "createdAt",
    "updatedAt",
    "prompt",
    "ppq",
    "tempoBpm",
    "meter",
    "swing",
    "lengthBars",
    "sections",
    "harmonicPlan",
    "tracks",
    "generation"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jev-music/project.v1.schema.json"
}
