{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a8os.jev.receipt.v1",
  "title": "Decision receipt — specs/ai/jev.md §8",
  "description": "One receipt per question per accepted attempt. It records providerClass beside providerId so an artifact can never read as calibrated when a DECODE provider produced it (§3.1a), and `model` is always what the provider RETURNED, never what was sent. `provenance: synthetic` (fixture runs) is never laundered.",
  "type": "object",
  "required": ["schemaVersion", "id", "jobId", "decisionIndex", "attemptIndex", "requestHash",
    "candidateHash", "providerId", "providerClass", "model", "promptTemplateVersion",
    "candidateMapVersion", "rosterVersion", "questionId", "answerType", "answerValue",
    "confidence", "selectionMode", "seedBefore", "seedAfter", "usage", "latencyMs", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "a8os.jev.receipt.v1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"},
    "jobId": {"type": "string", "minLength": 1},
    "decisionIndex": {"type": "integer", "minimum": 0},
    "attemptIndex": {"type": "integer", "minimum": 1},
    "requestHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "providerId": {"type": "string", "minLength": 1},
    "providerClass": {"enum": ["TRAINED", "DECODE", "DIFFUSION", "FIXTURE"]},
    "model": {"type": "string", "minLength": 1},
    "promptTemplateVersion": {"type": "string", "minLength": 1},
    "candidateMapVersion": {"type": "string", "minLength": 1},
    "rosterVersion": {"type": "string", "minLength": 1},
    "questionId": {"type": "string", "minLength": 1},
    "answerType": {"enum": ["noul", "choice", "score"]},
    "providerChoice": {"type": ["string", "null"]},
    "selectedChoice": {"type": ["string", "null"]},
    "answerValue": {"type": ["string", "number"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "selectionMode": {"enum": ["model", "sample"]},
    "seedBefore": {"type": "integer", "minimum": 0},
    "seedAfter": {"type": "integer", "minimum": 0},
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens", "complete"],
      "properties": {
        "inputTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"}
      }
    },
    "latencyMs": {"type": "number", "minimum": 0},
    "provenance": {"enum": ["live", "synthetic"]}
  }
}
